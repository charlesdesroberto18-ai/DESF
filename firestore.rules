rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isMonthKey(id) {
      return id is string && id.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function hasValidBudgetShape(data) {
      return data.keys().hasAll(['month_name', 'year', 'incomes', 'fixed_expenses', 'saving_goals', 'variable_expenses'])
        && data.keys().hasOnly(['month_name', 'year', 'incomes', 'fixed_expenses', 'saving_goals', 'variable_expenses', 'custom_categories', 'account_categories', 'observations', 'updated_at'])
        && data.month_name is string
        && data.month_name.size() <= 100
        && data.year is int
        && data.year >= 2000
        && data.year <= 2100
        && data.incomes is list
        && data.incomes.size() <= 5000
        && data.fixed_expenses is list
        && data.fixed_expenses.size() <= 1000
        && data.saving_goals is list
        && data.saving_goals.size() <= 500
        && data.variable_expenses is list
        && data.variable_expenses.size() <= 10000
        && (!data.keys().hasAny(['custom_categories']) || (data.custom_categories is list && data.custom_categories.size() <= 500))
        && (!data.keys().hasAny(['account_categories']) || (data.account_categories is list && data.account_categories.size() <= 500))
        && (!data.keys().hasAny(['observations']) || data.observations is map)
        && (!data.keys().hasAny(['updated_at']) || data.updated_at is string);
    }

    match /monthly_budgets/{monthKey} {
      allow get, list: if true;
      allow create, update: if isMonthKey(monthKey) && hasValidBudgetShape(request.resource.data);
      allow delete: if isMonthKey(monthKey);
    }
  }
}
